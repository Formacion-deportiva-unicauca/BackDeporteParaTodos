<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>co.edu.unicauca.deporteParaTodos</groupId>
	<artifactId>deporteParaTodos</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>deporteParaTodos</name>
	<description>desarrollo de prueba spring</description>
	<properties>
		<java.version>17</java.version>
		<sonar.organization>formacion-deportiva-unicauca</sonar.organization>
		<sonar.projectKey>Formacion-deportiva-unicauca_BackDeporteParaTodos</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.exclusions>**/entidades/**,**/excepciones/**,**/DTOs/**,**/*Application.java</sonar.exclusions>
	</properties>
	<dependencies>

		<dependency>
    		<groupId>org.springdoc</groupId>
    		<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    		<version>2.3.0</version>
		</dependency>

	
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--dependencia para MySQL DataBase (version gestionada por Spring Boot BOM 3.2.3)-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
		</dependency>
		<!--dependencia para JPA-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa </artifactId>
		</dependency>
		<!--Autogestion de compilacion y ejecion-->
		<dependency>
   			<groupId>org.springframework.boot</groupId>
    		<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
    		<optional>true</optional>
		</dependency>
		<!--Gestión de anotaciones para metodos repetitivos, principalmente en las entidades-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		<!--validaciones de datos-->
		</dependency>
				<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!--
			mapeo de objetos automatico
			https://modelmapper.org/getting-started/
		-->
		<dependency>
  			<groupId>org.modelmapper</groupId>
  			<artifactId>modelmapper</artifactId>
  			<version>3.0.0</version>
		</dependency>

		<!--Dependencia para controlar ciclos-->
		<dependency>
    		<groupId>com.fasterxml.jackson.core</groupId>
  			<artifactId>jackson-databind</artifactId>
   			<version>2.15.2</version> <!-- o la última versión disponible -->
		</dependency>

		<!-- Spring Security + OAuth2 Resource Server (valida tokens Google, emite JWT propio) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>


	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<parameters>true</parameters>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
				<version>5.7.0.6970</version>
			</plugin>
			<!-- Ejecuta **/*IT.java (tests de integracion contra BD real) en la fase
			     verify, separados de los tests unitarios de Surefire (**/*Test.java). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.11</version>
				<configuration>
					<excludes>
						<exclude>**/entidades/**</exclude>
						<exclude>**/excepciones/**</exclude>
						<exclude>**/DTOs/**</exclude>
						<exclude>**/*Application.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals><goal>report</goal></goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>skip-integration-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludes>
								<!-- DesarrollopruebaApplicationTests requiere conexion a base de datos activa.
								     MySQL esta disponible en CI desde SCRUM-163 (service container en GitHub Actions).
								     Este perfil sigue siendo util para desarrollo local sin Docker activo:
								       mvn verify -P skip-integration-tests -->
								<!-- LIMITACION DOCUMENTADA (SCRUM-163): GitHub Actions services: no soporta
								     pasar el flag lower_case_table_names=1 al daemon de MySQL (solo acepta options:
								     de docker run, no argumentos del proceso mysqld). Para tests de integracion
								     reales con queries a tablas, la solucion definitiva es migrar los CREATE TABLE
								     del DDL a nombres en minusculas (convencion estandar MySQL/Linux), eliminando
								     la necesidad del flag tanto en CI como en docker-compose local. -->
								<exclude>**/DesarrollopruebaApplicationTests.java</exclude>
							</excludes>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<excludes>
								<!-- Todos requieren BD MySQL real. -->
								<exclude>**/InscripcionConcurrenciaIT.java</exclude>
								<exclude>**/GrupoIT.java</exclude>
								<exclude>**/InscripcionEstadoCursoIT.java</exclude>
								<exclude>**/ClaseFechaDuplicadaIT.java</exclude>
								<exclude>**/InstructorIT.java</exclude>
								<exclude>**/InscripcionMisCursosIT.java</exclude>
							</excludes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
